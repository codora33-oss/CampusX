datasource db { provider = "postgresql"; url = env("DATABASE_URL") }
generator client { provider = "prisma-client-js" }

enum Visibility { PUBLIC UNIVERSITY CONNECTIONS GROUP }
enum GroupRole { OWNER ADMIN MODERATOR MEMBER }
enum EventStatus { PUBLISHED CANCELLED }
enum ListingStatus { ACTIVE RESERVED SOLD }

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  username String @unique
  name String
  avatarUrl String?
  bio String?
  university String
  campus String
  faculty String?
  department String?
  program String?
  level String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts Post[]
  comments Comment[]
  reactions Reaction[]
  following Follow[] @relation("Following")
  followers Follow[] @relation("Followers")
  sentRequests Connection[] @relation("Requester")
  receivedRequests Connection[] @relation("Addressee")
  memberships GroupMember[]
  organizedEvents Event[] @relation("Organizer")
  eventAttendees EventAttendee[]
  messages Message[]
  conversationMembers ConversationMember[]
  notifications Notification[]
  listings MarketplaceListing[]
  questions Question[]
  answers Answer[]
  resources Resource[]
  bookmarks Bookmark[]
  blocked Block[] @relation("BlockedBy")
  blockedBy Block[] @relation("BlockedUser")
  muted Mute[] @relation("MutedBy")
  mutedBy Mute[] @relation("MutedUser")
}
model Follow {
  id String @id @default(cuid())
  followerId String
  followingId String
  createdAt DateTime @default(now())
  follower User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  @@unique([followerId, followingId])
  @@index([followingId])
}
model Connection {
  id String @id @default(cuid())
  requesterId String
  addresseeId String
  status String @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  requester User @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("Addressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  @@unique([requesterId, addresseeId])
}
model Post {
  id String @id @default(cuid())
  authorId String
  body String
  visibility Visibility @default(UNIVERSITY)
  groupId String?
  courseCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  group Group? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  comments Comment[]
  reactions Reaction[]
  shares Share[]
  bookmarks Bookmark[]
  @@index([createdAt])
  @@index([authorId, createdAt])
}
model Comment {
  id String @id @default(cuid())
  postId String
  authorId String
  body String
  parentId String?
  createdAt DateTime @default(now())
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent Comment? @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("Replies")
  @@index([postId, createdAt])
}
model Reaction {
  id String @id @default(cuid())
  postId String
  userId String
  type String @default("LIKE")
  createdAt DateTime @default(now())
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([postId, userId])
}
model Share {
  id String @id @default(cuid())
  postId String
  userId String
  createdAt DateTime @default(now())
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([postId, userId])
}
model Bookmark {
  id String @id @default(cuid())
  postId String
  userId String
  createdAt DateTime @default(now())
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([postId, userId])
}
model Group {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String
  campus String
  coverUrl String?
  createdAt DateTime @default(now())
  members GroupMember[]
  posts Post[]
}
model GroupMember {
  id String @id @default(cuid())
  groupId String
  userId String
  role GroupRole @default(MEMBER)
  createdAt DateTime @default(now())
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([groupId, userId])
}
model Event {
  id String @id @default(cuid())
  title String
  description String
  organizerId String
  campus String
  location String
  startsAt DateTime
  endsAt DateTime
  status EventStatus @default(PUBLISHED)
  createdAt DateTime @default(now())
  organizer User @relation("Organizer", fields: [organizerId], references: [id], onDelete: Cascade)
  attendees EventAttendee[]
  @@index([startsAt])
}
model EventAttendee {
  id String @id @default(cuid())
  eventId String
  userId String
  status String @default("GOING")
  createdAt DateTime @default(now())
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([eventId, userId])
}
model Conversation {
  id String @id @default(cuid())
  createdAt DateTime @default(now())
  members ConversationMember[]
  messages Message[]
}
model ConversationMember {
  id String @id @default(cuid())
  conversationId String
  userId String
  lastReadAt DateTime?
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([conversationId, userId])
}
model Message {
  id String @id @default(cuid())
  conversationId String
  senderId String
  body String
  createdAt DateTime @default(now())
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}
model Notification {
  id String @id @default(cuid())
  userId String
  type String
  text String
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}
model Resource {
  id String @id @default(cuid())
  title String
  description String
  courseCode String?
  url String
  uploaderId String
  createdAt DateTime @default(now())
  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  @@index([courseCode])
}
model Question {
  id String @id @default(cuid())
  title String
  body String
  courseCode String?
  authorId String
  createdAt DateTime @default(now())
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  answers Answer[]
}
model Answer {
  id String @id @default(cuid())
  questionId String
  authorId String
  body String
  createdAt DateTime @default(now())
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}
model MarketplaceListing {
  id String @id @default(cuid())
  title String
  description String
  price Int
  category String
  condition String
  campus String
  status ListingStatus @default(ACTIVE)
  sellerId String
  createdAt DateTime @default(now())
  seller User @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  @@index([campus, status])
}
model Block {
  id String @id @default(cuid())
  blockerId String
  blockedId String
  blocker User @relation("BlockedBy", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)
  @@unique([blockerId, blockedId])
}
model Mute {
  id String @id @default(cuid())
  muterId String
  mutedId String
  muter User @relation("MutedBy", fields: [muterId], references: [id], onDelete: Cascade)
  muted User @relation("MutedUser", fields: [mutedId], references: [id], onDelete: Cascade)
  @@unique([muterId, mutedId])
}
